import { Injectable } from '@nestjs/common';
<% if (it.conventions.orm === 'drizzle') { %>
import { InjectDrizzle } from '@nestjs/drizzle';
import type { NodePgDatabase } from 'drizzle-orm/node-postgres';

@Injectable()
export class <%= it.names.pascal %>Repository {
  constructor(
    @InjectDrizzle()
    private readonly db: NodePgDatabase,
  ) {}
}
<% } else if (it.conventions.orm === 'prisma') { %>
<%
const aliasBase = it.conventions.pathAlias
  ? it.conventions.pathAlias.replace(/\/features\/?$/, '').replace(/\/+$/, '')
  : '';
const prismaImport = aliasBase
  ? (aliasBase + '/infrastructure/prisma/prisma.service' + it.conventions.importExtension)
  : ('../../infrastructure/prisma/prisma.service' + it.conventions.importExtension);
%>
import { PrismaService } from '<%= prismaImport %>';

@Injectable()
export class <%= it.names.pascal %>Repository {
  constructor(
    private readonly prisma: PrismaService,
  ) {}
}
<% } else if (it.conventions.orm === 'typeorm') { %>
import { DataSource } from 'typeorm';

@Injectable()
export class <%= it.names.pascal %>Repository {
  constructor(
    private readonly dataSource: DataSource,
  ) {}
}
<% } else { %>
@Injectable()
export class <%= it.names.pascal %>Repository {
  constructor() {}
}
<% } %>
