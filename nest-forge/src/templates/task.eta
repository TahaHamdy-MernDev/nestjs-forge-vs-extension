import { Injectable, Logger } from '@nestjs/common';
import { Cron, CronExpression } from '@nestjs/schedule';

@Injectable()
export class <%= it.taskClassName %> {
  private readonly logger = new Logger(<%= it.taskClassName %>.name);

  @Cron(CronExpression.EVERY_HOUR)
  async handleCron(): Promise<void> {
    this.logger.debug('Running scheduled task: <%= it.taskClassName %>');
  }
}
