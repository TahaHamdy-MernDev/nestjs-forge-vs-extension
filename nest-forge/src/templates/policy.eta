import { Policy, type PolicyBefore } from '@nestjs/authorization';
<%
const authImport = (it.conventions.pathAlias && it.conventions.pathAlias.startsWith('@/features'))
  ? (it.conventions.pathAlias + '/auth/auth.interface' + it.conventions.importExtension)
  : (it.conventions.pathAlias
    ? (it.conventions.pathAlias.replace(/\/+$/, '') + '/features/auth/auth.interface' + it.conventions.importExtension)
    : ('../auth/auth.interface' + it.conventions.importExtension));
%>
import type { PolicyUser } from '<%= authImport %>';

@Policy()
export class <%= it.policyClassName || (it.names.pascal + 'Policy') %> implements PolicyBefore<PolicyUser> {
  before(user: PolicyUser) {
    return user ? undefined : false;
  }
}
